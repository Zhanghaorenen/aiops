# Reference only: the service reads process environment variables, not this file.
AIOPS_BACKEND_URL=http://127.0.0.1:8080
AIOPS_WEB_ALLOWED_ORIGIN=http://localhost:5173
AIOPS_LLM_BASE_URL=
AIOPS_LLM_MODEL=
AIOPS_LLM_API_KEY=
# Match root .env when starting FastAPI independently. Redis outages fail closed with HTTP 503.
AIOPS_REDIS_ENABLED=true
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DB=0
AIOPS_REDIS_PASSWORD=
AIOPS_REDIS_KEY_PREFIX=aiops:
AIOPS_REDIS_TIMEOUT_SECONDS=0.5
AIOPS_CHAT_RATE_PER_MINUTE=20
AIOPS_MEMORY_TOP_K=4
AIOPS_MEMORY_SCORE_THRESHOLD=0.72
AIOPS_MEMORY_CONTEXT_CHARS=2000
AIOPS_MEMORY_RECALL_TIMEOUT=2
AIOPS_MULTI_AGENT_ENABLED=false

# Optional engineering features
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aiops-ai
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_ENABLED=false
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AIOPS_HYBRID_ENABLED=false
AIOPS_RERANKER_ENABLED=false
AIOPS_RERANKER_PATH=
AIOPS_RERANKER_DEVICE=cpu
AIOPS_CHECKPOINT_ENABLED=false
AIOPS_MCP_ENABLED=false
AIOPS_MCP_PORT=8010
AIOPS_MCP_ISSUER=
AIOPS_MCP_JWKS=
AIOPS_MCP_RESOURCE=
AIOPS_MCP_DELEGATIONS=
AIOPS_PROMPT_VERSION=aiops-engineering-v1
AIOPS_EVAL_TRACE_CONTENT=false
# Optional STDIO identity, supplied privately by the client environment.
AIOPS_MCP_USER_JWT=
# Optional evaluation-only MySQL writer.
AIOPS_EVAL_DB_HOST=127.0.0.1
AIOPS_EVAL_DB_PORT=3306
AIOPS_EVAL_DB_NAME=
AIOPS_EVAL_DB_USER=
AIOPS_EVAL_DB_PASSWORD=
