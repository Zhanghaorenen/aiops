# Reference only: the service reads process environment variables, not this file.
AIOPS_BACKEND_URL=http://127.0.0.1:8080
AIOPS_WEB_ALLOWED_ORIGIN=http://localhost:5173
AIOPS_LLM_BASE_URL=
AIOPS_LLM_MODEL=
AIOPS_LLM_API_KEY=
# Match root .env when starting FastAPI independently. Redis outages fail closed with HTTP 503.
AIOPS_REDIS_ENABLED=true
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DB=0
AIOPS_REDIS_PASSWORD=
AIOPS_REDIS_KEY_PREFIX=aiops:
AIOPS_REDIS_TIMEOUT_SECONDS=0.5
AIOPS_CHAT_RATE_PER_MINUTE=20
