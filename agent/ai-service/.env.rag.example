# Copy settings into the service environment; do not commit real secrets.
AIOPS_BACKEND_URL=http://127.0.0.1:8080
# Same independent random key (>=32 characters) in Spring Boot and FastAPI.
AIOPS_RAG_SERVICE_KEY=
AIOPS_QDRANT_URL=http://127.0.0.1:6333
AIOPS_QDRANT_KEY=
# Offline SentenceTransformer model directory; no automatic model download.
AIOPS_EMBEDDING_PATH=
# Immutable model repository revision / artifact checksum, <=100 characters.
AIOPS_EMBEDDING_VERSION=
# Set an absolute private directory in production.
AIOPS_RAG_STORAGE_DIR=
AIOPS_RAG_CHUNK_SIZE=1000
AIOPS_RAG_CHUNK_OVERLAP=150
