# For scripts/run.py: copy to .env and fill private values (no interpolation).
AIOPS_DB_URL=jdbc:mysql://localhost:3306/aiops?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
AIOPS_DB_USERNAME=aiops
AIOPS_DB_PASSWORD=
# Standard Base64, decoded length >=32 bytes. Keep stable across restarts.
AIOPS_JWT_SECRET=
AIOPS_ADMIN_USERNAME=admin
# First creation only: 12-72 characters. Does not reset existing users.
AIOPS_ADMIN_PASSWORD=
AIOPS_WEB_ALLOWED_ORIGIN=http://localhost:5173
AIOPS_BACKEND_URL=http://127.0.0.1:8080
AIOPS_AI_SERVICE_URL=http://127.0.0.1:8000
# Verify the actual user ID before enabling one-time bootstrap.
AIOPS_CLUSTER_BOOTSTRAP_ENABLED=false
AIOPS_CLUSTER_BOOTSTRAP_USER_ID=0
# Optional model
AIOPS_LLM_BASE_URL=
AIOPS_LLM_MODEL=
AIOPS_LLM_API_KEY=
# Separate random service keys >=32 characters; match on both services.
AIOPS_AI_SERVICE_KEY=
AIOPS_RAG_SERVICE_KEY=
# Optional RAG; compose.rag.yaml reads AIOPS_QDRANT_KEY.
AIOPS_QDRANT_URL=http://127.0.0.1:6333
AIOPS_QDRANT_KEY=
AIOPS_EMBEDDING_PATH=
AIOPS_EMBEDDING_VERSION=
AIOPS_RAG_STORAGE_DIR=data/knowledge

# Redis: same credentials/prefix on Java and FastAPI. Generate a random URL-safe password.
AIOPS_REDIS_ENABLED=true
AIOPS_REDIS_HOST=127.0.0.1
AIOPS_REDIS_PORT=6379
AIOPS_REDIS_DB=0
AIOPS_REDIS_PASSWORD=
AIOPS_REDIS_KEY_PREFIX=aiops:
AIOPS_REDIS_CACHE_TTL=5s
AIOPS_REDIS_TIMEOUT=500ms
AIOPS_REDIS_TIMEOUT_SECONDS=0.5
AIOPS_CHAT_RATE_PER_MINUTE=20

# Chat memories are OFF per user until explicitly enabled in Personal records.
# Worker uses the existing AIOPS_AI_SERVICE_KEY and authenticated user requests.
AIOPS_CHAT_MEMORY_WORKER_ENABLED=true
AIOPS_CHAT_MEMORY_ROUNDS=5
AIOPS_MEMORY_TOP_K=4
AIOPS_MEMORY_SCORE_THRESHOLD=0.72
AIOPS_MEMORY_CONTEXT_CHARS=2000
AIOPS_MEMORY_RECALL_TIMEOUT=2

# Read-only autonomous investigation hard budgets.
AIOPS_INVESTIGATION_ROUNDS=4
AIOPS_INVESTIGATION_CALLS=12
AIOPS_INVESTIGATION_SECONDS=150
